# ---------- Database ----------
# SQLite by default -- no separate database server needed.
DATABASE_URL=sqlite:///./life_admin.db

# ---------- Auth ----------
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- Claude API ----------
# Get a real key from https://console.anthropic.com
# Leave as "mock" to run WITHOUT a real key (agents return canned responses)
ANTHROPIC_API_KEY=mock
CLAUDE_MODEL=claude-sonnet-4-6

# ---------- Opportunity Discovery (external job/course/scholarship sources) ----------
# Leave as "mock" -- real LinkedIn Jobs / Google Jobs / Coursera API access
# requires partnerships or paid tiers most students won't have. Mock mode
# returns realistic sample listings through the exact same code path real
# APIs would use, so swapping in real keys later needs no code changes.
OPPORTUNITY_SOURCE_MODE=mock

# ---------- Notifications ----------
# Leave as "mock" to log notifications to console instead of sending real ones
SMTP_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

FIREBASE_MODE=mock
FIREBASE_SERVER_KEY=

# ---------- Google Calendar ----------
GOOGLE_CALENDAR_MODE=mock
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# ---------- AI Memory (ChromaDB) ----------
# Runs embedded/local by default -- no separate server needed.
CHROMA_PERSIST_DIR=./chroma_data

# ---------- App ----------
ENVIRONMENT=development
